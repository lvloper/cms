@props(['style'=>'default'])
@php
$isPreview = isset($preview);
$videoType = $videoType ?? 'youtube';

if ($videoType === 'youtube' && isset($videoId)) {
    if (preg_match('/(?:youtube\.com\/(?:[^\/\n\s]+\/\s*(?:\w*\/)*|(?:v|e(?:mbed)?)\/|\w*v=)|youtu\.be\/)([a-zA-Z0-9_-]{11})/', 
    $videoId, $matches)) {
        $videoId = $matches[1];
    }
}
@endphp
<x-block id="{{ $id }}" class="relative">
    @if($isPreview && $style == 'animation')
    @php
    $style = 'default';
    @endphp
    <div
        class="absolute inset-0 z-50 p-20 text-center flex justify-center items-center bg-[rgba(255,255,255,0.4)] rounded-md ">
        <h1>El efecto de animación no se puede visualizar en el la vista de preview</h1>
    </div>
    @endif

    @if($style == 'animation')
    <div class="xl:h-[130vh] bg-gray-3 overflow-hidden relative">
        <div
            class="absolute top-1/3 left-1/2 w-32 h-32 rounded-full transition-transform duration-500 ease-in-out transform -translate-x-1/2 -translate-y-1/2 circle-animate bg-primary">
        </div>
        <svg xmlns="http://www.w3.org/2000/svg"
            class="absolute top-1/3 left-1/2 mx-auto text-white transform -translate-x-1/2 -translate-y-1/2 cursor-pointer svg-animate"
            width="50" height="50" viewBox="0 0 24 24" fill="white" stroke="currentColor" stroke-width="1.25"
            stroke-linecap="round" stroke-linejoin="round" onclick="scrollToVideo('{{ $id }}')">
            <polygon points="6 3 20 12 6 21 6 3" />
        </svg>
        <div class="video-animate w-[85%] lg:w-3/5 sticky mx-auto top-[45%] lg:top-[30%]">

            <lite-youtube videoid='{{ $videoId }}'></lite-youtube>
        </div>
    </div>

    @pushonce('scripts', 'video-block')
    <style>
        .video-animate {
            opacity: 0;
            transform: translateY(20%);
        }
    </style>
    <script>
        document.addEventListener('livewire:navigated', function() {
                const BLOCK = document.getElementById('{{ $id }}');
                const circle = BLOCK.querySelector('.circle-animate');
                const svg = BLOCK.querySelector('.svg-animate');
                const video = BLOCK.querySelector('.video-animate');


                gsap.to(circle, {
                    scrollTrigger: {
                        trigger: BLOCK,
                        start: "top top",
                        end: "50% top",
                        scrub: true,
                        pin: true,
                        toggleActions: 'play reverse none none',
                    },
                    width: "+=300rem",
                    height: "+=300rem",
                    ease: "none"
                });

                gsap.to(svg, {
                    scrollTrigger: {
                        trigger: BLOCK,
                        start: "top top",
                        end: "20% top",
                        scrub: true,
                        toggleActions: 'play reverse none none',
                    },
                    opacity: 0
                });

                gsap.to(video, {
                    scrollTrigger: {
                        trigger: BLOCK,
                        start: "15% top",
                        end: "bottom top",
                        scrub: true,
                        pin: true,
                        toggleActions: 'play reverse none none',
                    },
                    transform: 'translateY(0)',
                    opacity: 1,
                });

            });

            function scrollToVideo(id) {
                const BLOCK = document.getElementById(id);
                const video = BLOCK.querySelector('lite-youtube');
                video.click();



                gsap.to(window, {
                    duration: 2,
                    scrollTo: {
                        y: BLOCK.getBoundingClientRect().top + window.scrollY + BLOCK.offsetHeight,
                    },
                    ease: "power2.inOut"
                });
            }
    </script>
    @endpushonce
    @else

    {{-- Default --}}
    <div class="{{ $style }} mx-auto w-full video-animate ">
        <div class="{{ $style == 'compact' ? 'pt-6 pb-12 max-w-[950px]' : '' }}">
            <lite-youtube videoid='{{ $videoId }}'></lite-youtube>
        </div>
    </div>
    @endif
</x-block>