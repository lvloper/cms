# WordPress Database Configuration
# Add these variables to your .env file to connect to WordPress database

# WordPress Database Connection
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=huesped-wponline
WP_DB_USERNAME=root
WP_DB_PASSWORD=
WP_DB_CHARSET=utf8mb4
WP_DB_COLLATION=utf8mb4_unicode_ci
WP_DB_PREFIX=wp_

# Optional: WordPress Database URL (alternative to individual settings)
# WP_DB_URL=mysql://username:password@host:port/database

# Optional: WordPress Database Socket (for local connections)
# WP_DB_SOCKET=/tmp/mysql.sock